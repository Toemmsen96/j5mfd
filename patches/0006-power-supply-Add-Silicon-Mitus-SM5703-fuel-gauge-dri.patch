+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5703-fuel-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5703 Fuel Gauge
+
+maintainers:
+  - Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
+
+description: |
+  The fuel gauge of the Silicon Mitus SM5703 PMIC is a separate I2C device.
+  It estimates the battery state of charge from the battery voltage and
+  current using a battery model kept in volatile memory. The model is lost
+  whenever the gauge loses power, for example when a removable battery is
+  pulled, and is then programmed again from the properties below.
+
+  All battery model values are raw 16-bit register values as found in the
+  vendor device tree for the specific battery. If the battery model is
+  given, all of its properties are required.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5703-fuel-gauge
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: Alert interrupt, used for the low state of charge alert.
+
+  siliconmitus,battery-table-0:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Discharge OCV table, written to registers 0xa0-0xaf.
+    minItems: 16
+    maxItems: 16
+    items:
+      maximum: 0xffff
+
+  siliconmitus,battery-table-1:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Charge OCV table, written to registers 0xb0-0xbf.
+    minItems: 16
+    maxItems: 16
+    items:
+      maximum: 0xffff
+
+  siliconmitus,battery-table-2:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Capacity (Q) table, written to registers 0xc0-0xcf.
+    minItems: 16
+    maxItems: 16
+    items:
+      maximum: 0xffff
+
+  siliconmitus,rce:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: RCE0-RCE2 values (registers 0x20-0x22).
+    minItems: 3
+    maxItems: 3
+    items:
+      maximum: 0xffff
+
+  siliconmitus,dtcd:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: DTCD value (register 0x23).
+    maximum: 0xffff
+
+  siliconmitus,rs:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Battery resistance RS value (register 0x24).
+    maximum: 0xffff
+
+  siliconmitus,rs-mix-factor:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: RS mixing factor (register 0x25).
+    maximum: 0xffff
+
+  siliconmitus,rs-max:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Maximum RS value (register 0x26).
+    maximum: 0xffff
+
+  siliconmitus,rs-min:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Minimum RS value (register 0x27).
+    maximum: 0xffff
+
+  siliconmitus,vit-period:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Voltage, current and temperature measurement period
+      (register 0x1a).
+    maximum: 0xffff
+
+  siliconmitus,mix-rate:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Mixing rate (register 0x1b).
+    maximum: 0xffff
+
+  siliconmitus,mix-init-blank:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Mixing initial blank time (register 0x1c).
+    maximum: 0xffff
+
+  siliconmitus,volt-cal:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Voltage calibration (register 0x2b).
+    maximum: 0xffff
+
+  siliconmitus,curr-cal:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Current calibration (register 0x2c).
+    maximum: 0xffff
+
+  siliconmitus,topoff-soc:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Top-off state of charge setting (register 0x12).
+    maximum: 0xffff
+
+  siliconmitus,topoff-soc-enable:
+    type: boolean
+    description: Enable the top-off state of charge function.
+
+dependentRequired:
+  siliconmitus,battery-table-0:
+    - siliconmitus,battery-table-1
+    - siliconmitus,battery-table-2
+    - siliconmitus,rce
+    - siliconmitus,dtcd
+    - siliconmitus,rs
+    - siliconmitus,rs-mix-factor
+    - siliconmitus,rs-max
+    - siliconmitus,rs-min
+    - siliconmitus,vit-period
+    - siliconmitus,mix-rate
+    - siliconmitus,mix-init-blank
+    - siliconmitus,volt-cal
+    - siliconmitus,curr-cal
+    - siliconmitus,topoff-soc
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      fuel-gauge@71 {
+        compatible = "siliconmitus,sm5703-fuel-gauge";
+        reg = <0x71>;
+        interrupts-extended = <&tlmm 121 IRQ_TYPE_EDGE_FALLING>;
+
+        siliconmitus,battery-table-0 = <0x1400 0x1b33 0x1c4d 0x1d6c 0x1d88
+                                        0x1db9 0x1de0 0x1dfa 0x1e26 0x1e9e
+                                        0x1ecd 0x1f12 0x1f60 0x20e9 0x225c
+                                        0x2399>;
+        siliconmitus,battery-table-1 = <0x1400 0x1b33 0x1c4d 0x1d6c 0x1d88
+                                        0x1db9 0x1de0 0x1dfa 0x1e26 0x1e9e
+                                        0x1ecd 0x1f12 0x1f60 0x20e9 0x225c
+                                        0x2399>;
+        siliconmitus,battery-table-2 = <0x0000 0x002f 0x00b8 0x0171 0x02fc
+                                        0x0380 0x0403 0x0487 0x058f 0x09ad
+                                        0x0ab5 0x0bbc 0x0c40 0x10e2 0x1497
+                                        0x149c>;
+        siliconmitus,rce = <0x0749 0x0580 0x0371>;
+        siliconmitus,dtcd = <0x0001>;
+        siliconmitus,rs = <0x01ae>;
+        siliconmitus,rs-mix-factor = <0x047a>;
+        siliconmitus,rs-max = <0x3800>;
+        siliconmitus,rs-min = <0x00a4>;
+        siliconmitus,vit-period = <0x3506>;
+        siliconmitus,mix-rate = <0x0503>;
+        siliconmitus,mix-init-blank = <0x0004>;
+        siliconmitus,volt-cal = <0x8000>;
+        siliconmitus,curr-cal = <0x7500>;
+        siliconmitus,topoff-soc = <0x0005>;
+      };
+    };
