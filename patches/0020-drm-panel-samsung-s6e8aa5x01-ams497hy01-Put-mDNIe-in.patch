From 91e56044fbc3839afffb0c481492a0e181a5d51e Mon Sep 17 00:00:00 2001
From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Date: Mon, 5 Oct 2026 21:59:10 +0200
Subject: [PATCH] drm/panel: samsung-s6e8aa5x01-ams497hy01: Put mDNIe in bypass
 mode at init

The S6E8AA5X01 DDIC has an image enhancement block (mDNIe) that the
vendor kernel programs on every panel power-on. The generated init
sequence never touches it, leaving it in whatever state the DDIC resets
to. On the Galaxy J5 (2015) this shows as coloured, dither-like noise on
light areas on the right part of the screen, stronger around UI edges
and with motion, invisible in screenshots and unaffected by DSI PHY
settings: the enhancer processing part of the frame (its region of
interest / demo split). Send the vendor's bypass tables (0xEB: enable
with all algorithms and ROI off; 0xEC: identity curves) inside the
level-1 key window of the init sequence.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../panel-samsung-s6e8aa5x01-ams497hy01.c     | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/gpu/drm/panel/msm8916-generated/panel-samsung-s6e8aa5x01-ams497hy01.c b/drivers/gpu/drm/panel/msm8916-generated/panel-samsung-s6e8aa5x01-ams497hy01.c
index ee22cef89..8cdc19b63 100644
--- a/drivers/gpu/drm/panel/msm8916-generated/panel-samsung-s6e8aa5x01-ams497hy01.c
+++ b/drivers/gpu/drm/panel/msm8916-generated/panel-samsung-s6e8aa5x01-ams497hy01.c
@@ -891,6 +891,36 @@ static int s6e8aa5x01_ams497hy01_on(struct s6e8aa5x01_ams497hy01 *ctx)
 	mipi_dsi_dcs_write_seq(dsi, 0xc0, 0xd8, 0xd8, 0x40);
 	mipi_dsi_dcs_write_seq(dsi, 0xb8,
 			       0x38, 0x00, 0x00, 0x60, 0x44, 0x00, 0xa8);
+
+	/*
+	 * mDNIe (the DDIC's image enhancer) in bypass mode: all algorithms
+	 * off, no region of interest, identity curves. The vendor kernel
+	 * programs this (or a tuned mode) on every panel-on; left at its
+	 * reset state the panel shows processing artefacts on part of the
+	 * screen. Tables: DSI0_BYPASS_MDNIE_1/2 from
+	 * ss_dsi_mdnie_S6E8AA5X01_AMS497HY01.h.
+	 */
+	mipi_dsi_dcs_write_seq(dsi, 0xeb, 0x01, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq(dsi, 0xec,
+			       0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			       0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			       0x00, 0x00, 0xff, 0x00, 0x00, 0x07, 0xff, 0x07,
+			       0xff, 0x01, 0x83, 0x00, 0x20, 0x00, 0x20, 0x00,
+			       0x20, 0x00, 0x20, 0x00, 0x20, 0x00, 0x20, 0x00,
+			       0x20, 0x00, 0x20, 0x00, 0x20, 0x00, 0x20, 0x00,
+			       0x20, 0x00, 0x20, 0x00, 0x20, 0x00, 0x20, 0x00,
+			       0x20, 0x00, 0x20, 0x00, 0x20, 0x00, 0x20, 0x00,
+			       0x20, 0x00, 0x20, 0x00, 0x20, 0x00, 0x20, 0x00,
+			       0x20, 0x00, 0xff, 0x30, 0x67, 0xa9, 0x0c, 0x0c,
+			       0x0c, 0x0c, 0x00, 0xaa, 0xab, 0x00, 0xaa, 0xab,
+			       0x00, 0xaa, 0xab, 0x00, 0xaa, 0xab, 0xd5, 0x2c,
+			       0x2a, 0xff, 0xf5, 0x63, 0xfe, 0x4a, 0xff, 0xff,
+			       0xf9, 0xf8, 0x00, 0xff, 0xff, 0x00, 0xff, 0x00,
+			       0xff, 0x00, 0x00, 0xff, 0xff, 0x00, 0xff, 0x00,
+			       0xff, 0x00, 0x00, 0xff, 0xff, 0x00, 0xff, 0x00,
+			       0xff, 0x00
+			       );
+
 	mipi_dsi_dcs_write_seq(dsi, 0xf0, 0xa5, 0xa5);
 
 	ret = s6e8aa5x01_set_brightness(ctx, s6e8aa5x01_ams497hy01_brightness(ctx));
-- 
