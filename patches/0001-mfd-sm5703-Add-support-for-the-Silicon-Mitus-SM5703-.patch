--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1367,6 +1367,19 @@ config MFD_SM501_GPIO
 	  lines on the SM501. The platform data is used to supply the
 	  base number for the first GPIO line to register.
 
+config MFD_SM5703
+	tristate "Silicon Mitus SM5703 PMIC"
+	depends on I2C
+	depends on OF
+	select MFD_CORE
+	select REGMAP_I2C
+	help
+	  Core driver for the Silicon Mitus SM5703 PMIC found in several
+	  Samsung Galaxy phones (e.g. J5 2015, J7 2015). It provides LDO,
+	  buck and USB regulators, a battery charger, a flash LED driver,
+	  a fuel gauge and a MUIC. This option enables the shared register
+	  map; the regulators are handled by REGULATOR_SM5703.
+
 config MFD_SKY81452
 	tristate "Skyworks Solutions SKY81452"
 	select MFD_CORE
