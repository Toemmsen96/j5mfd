From 2e0b0ac10a3509b9bd03809faabdd05a48157cec Mon Sep 17 00:00:00 2001
From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Date: Mon, 5 Oct 2026 18:45:00 +0200
Subject: [PATCH 7/7] arm64: dts: qcom: msm8916-samsung-j5: Add SM5703 fuel
 gauge

The SM5703 fuel gauge sits at address 0x71 on a GPIO I2C bus (SDA GPIO
14, SCL GPIO 15) with its alert line on GPIO 121. Add it together with
the battery model of the J5 battery (battery id 0) from the downstream
msm8916-sec-j5-battery-r00.dtsi, so the gauge can be programmed again
after the battery was removed.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../boot/dts/qcom/msm8916-samsung-j5.dts      | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8916-samsung-j5.dts b/arch/arm64/boot/dts/qcom/msm8916-samsung-j5.dts
index fcb96070c..486d10f08 100644
--- a/arch/arm64/boot/dts/qcom/msm8916-samsung-j5.dts
+++ b/arch/arm64/boot/dts/qcom/msm8916-samsung-j5.dts
@@ -16,6 +16,53 @@ haptic {
 		max-microvolt = <3300000>;
 	};
 
+	i2c_fg: i2c-fg {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 14 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 15 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
+
+		pinctrl-0 = <&fg_i2c_default>;
+		pinctrl-names = "default";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		fuel-gauge@71 {
+			compatible = "siliconmitus,sm5703-fuel-gauge";
+			reg = <0x71>;
+
+			interrupts-extended = <&tlmm 121 IRQ_TYPE_EDGE_FALLING>;
+
+			siliconmitus,battery-table-0 = <0x1400 0x1b33 0x1c4d 0x1d6c
+							0x1d88 0x1db9 0x1de0 0x1dfa
+							0x1e26 0x1e9e 0x1ecd 0x1f12
+							0x1f60 0x20e9 0x225c 0x2399>;
+			siliconmitus,battery-table-1 = <0x1400 0x1b33 0x1c4d 0x1d6c
+							0x1d88 0x1db9 0x1de0 0x1dfa
+							0x1e26 0x1e9e 0x1ecd 0x1f12
+							0x1f60 0x20e9 0x225c 0x2399>;
+			siliconmitus,battery-table-2 = <0x0000 0x002f 0x00b8 0x0171
+							0x02fc 0x0380 0x0403 0x0487
+							0x058f 0x09ad 0x0ab5 0x0bbc
+							0x0c40 0x10e2 0x1497 0x149c>;
+			siliconmitus,rce = <0x0749 0x0580 0x0371>;
+			siliconmitus,dtcd = <0x0001>;
+			siliconmitus,rs = <0x01ae>;
+			siliconmitus,rs-mix-factor = <0x047a>;
+			siliconmitus,rs-max = <0x3800>;
+			siliconmitus,rs-min = <0x00a4>;
+			siliconmitus,vit-period = <0x3506>;
+			siliconmitus,mix-rate = <0x0503>;
+			siliconmitus,mix-init-blank = <0x0004>;
+			siliconmitus,volt-cal = <0x8000>;
+			siliconmitus,curr-cal = <0x7500>;
+			siliconmitus,topoff-soc = <0x0005>;
+
+			pinctrl-0 = <&fg_int_default>;
+			pinctrl-names = "default";
+		};
+	};
+
 	i2c_tkey: i2c-tkey {
 		compatible = "i2c-gpio";
 		sda-gpios = <&tlmm 101 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
@@ -180,6 +227,22 @@ &vtcam_flash_en_default {
 };
 
 &tlmm {
+	fg_i2c_default: fg-i2c-default-state {
+		pins = "gpio14", "gpio15";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	fg_int_default: fg-int-default-state {
+		pins = "gpio121";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	pmic_reset_default: pmic-reset-default-state {
 		pins = "gpio24";
 		function = "gpio";
-- 
2.56.0

