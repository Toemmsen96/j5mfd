+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5k5e3.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5K5E3 5 Mpixel raw image sensor
+
+maintainers:
+  - Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
+
+description:
+  The Samsung S5K5E3 (ISOCELL 5E3) is a 1/5" 2576x1932 raw Bayer image
+  sensor with a MIPI CSI-2 output of up to two data lanes and a CCI (I2C
+  compatible) control interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5k5e3
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: EXTCLK, 26 MHz.
+    maxItems: 1
+
+  vana-supply:
+    description: Analogue supply (2.8 V).
+
+  vdig-supply:
+    description: Digital core supply.
+
+  vio-supply:
+    description: Digital I/O supply (1.8 V).
+
+  reset-gpios:
+    description: GPIO connected to the RSTN pin (active low).
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            minItems: 2
+            maxItems: 2
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - vana-supply
+  - vdig-supply
+  - vio-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "samsung,s5k5e3";
+            reg = <0x10>;
+
+            clocks = <&camera_mclk>;
+            assigned-clocks = <&camera_mclk>;
+            assigned-clock-rates = <26000000>;
+
+            vana-supply = <&reg_cam_avdd>;
+            vdig-supply = <&reg_cam_dvdd>;
+            vio-supply = <&reg_cam_dovdd>;
+
+            reset-gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
+
+            orientation = <0>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <448500000>;
+                    remote-endpoint = <&csiphy1_ep>;
+                };
+            };
+        };
+    };
+...
