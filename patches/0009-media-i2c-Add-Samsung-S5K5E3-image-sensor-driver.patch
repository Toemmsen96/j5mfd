+		.exposure_def = 500,
+		.regs = s5k5e3_640x480_regs,
+		.num_regs = ARRAY_SIZE(s5k5e3_640x480_regs),
+	},
+};
+
+/*
+ * The Exynos driver declares the 5E3 as OTF_INPUT_ORDER_BAYER_GR_BG; the
+ * readout windows of all modes start on even coordinates, so the order is
+ * the same for every mode.
+ */
+#define S5K5E3_MBUS_CODE		MEDIA_BUS_FMT_SGRBG10_1X10
+
+struct s5k5e3 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *extclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[S5K5E3_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+
+	const struct s5k5e3_mode *mode;
+	u32 ana_gain_min;
+	u32 ana_gain_max;
+};
+
+static inline struct s5k5e3 *to_s5k5e3(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k5e3, sd);
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int s5k5e3_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k5e3 *s5k5e3 = container_of(ctrl->handler, struct s5k5e3,
+					     ctrls);
+	const struct s5k5e3_mode *mode = s5k5e3->mode;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exposure_max = mode->height + ctrl->val -
+				   S5K5E3_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(s5k5e3->exposure,
+					 s5k5e3->exposure->minimum,
+					 exposure_max, s5k5e3->exposure->step,
+					 min(exposure_max,
+					     (int)mode->exposure_def));
+	}
+
+	/* Registers are only written while the sensor is powered */
+	if (pm_runtime_get_if_in_use(s5k5e3->dev) <= 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_COARSE_INTEG_TIME,
+			  ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_ANALOG_GAIN,
+			  ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_FRAME_LENGTH,
+			  mode->height + ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k5e3->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k5e3_ctrl_ops = {
+	.s_ctrl = s5k5e3_set_ctrl,
+};
+
+static void s5k5e3_update_blanking(struct s5k5e3 *s5k5e3)
+{
+	const struct s5k5e3_mode *mode = s5k5e3->mode;
+	u32 vblank_def = mode->vts_def - mode->height;
+	u32 hblank = S5K5E3_LINE_LENGTH - mode->width;
+
+	/* Only frame lengths at or above the vendor setting are allowed. */
+	__v4l2_ctrl_modify_range(s5k5e3->vblank, vblank_def,
+				 S5K5E3_FRAME_LENGTH_MAX - mode->height, 1,
+				 vblank_def);
+	__v4l2_ctrl_s_ctrl(s5k5e3->vblank, vblank_def);
+	__v4l2_ctrl_modify_range(s5k5e3->exposure, S5K5E3_EXPOSURE_MIN,
+				 mode->vts_def - S5K5E3_EXPOSURE_MARGIN, 1,
+				 mode->exposure_def);
+	__v4l2_ctrl_modify_range(s5k5e3->hblank, hblank, hblank, 1, hblank);
+}
+
+static int s5k5e3_init_controls(struct s5k5e3 *s5k5e3)
+{
+	const struct s5k5e3_mode *mode = s5k5e3->mode;
+	struct v4l2_ctrl_handler *hdl = &s5k5e3->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 vblank_def = mode->vts_def - mode->height;
+	u32 hblank = S5K5E3_LINE_LENGTH - mode->width;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &s5k5e3_ctrl_ops, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(s5k5e3_link_freq_menu) - 1, 0,
+				      s5k5e3_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &s5k5e3_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  S5K5E3_PIXEL_RATE, S5K5E3_PIXEL_RATE, 1,
+			  S5K5E3_PIXEL_RATE);
+
+	s5k5e3->hblank = v4l2_ctrl_new_std(hdl, &s5k5e3_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (s5k5e3->hblank)
+		s5k5e3->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k5e3->vblank = v4l2_ctrl_new_std(hdl, &s5k5e3_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank_def,
+					   S5K5E3_FRAME_LENGTH_MAX - mode->height,
+					   1, vblank_def);
+
+	s5k5e3->exposure = v4l2_ctrl_new_std(hdl, &s5k5e3_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K5E3_EXPOSURE_MIN,
+					     mode->vts_def -
+					     S5K5E3_EXPOSURE_MARGIN, 1,
+					     mode->exposure_def);
+
+	v4l2_ctrl_new_std(hdl, &s5k5e3_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  s5k5e3->ana_gain_min, s5k5e3->ana_gain_max, 1,
+			  s5k5e3->ana_gain_min);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(s5k5e3->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &s5k5e3_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	s5k5e3->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return dev_err_probe(s5k5e3->dev, ret, "failed to init controls\n");
+}
+
+/* -----------------------------------------------------------------------------
+ * Streaming
+ */
+
+static int s5k5e3_start_streaming(struct s5k5e3 *s5k5e3)
+{
+	const struct s5k5e3_mode *mode = s5k5e3->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k5e3->dev);
+	if (ret < 0)
+		return ret;
+
+	cci_multi_reg_write(s5k5e3->regmap, s5k5e3_common_regs,
+			    ARRAY_SIZE(s5k5e3_common_regs), &ret);
+	cci_multi_reg_write(s5k5e3->regmap, mode->regs, mode->num_regs, &ret);
+	cci_multi_reg_write(s5k5e3->regmap, s5k5e3_common_tail_regs,
+			    ARRAY_SIZE(s5k5e3_common_tail_regs), &ret);
+	if (ret) {
+		dev_err(s5k5e3->dev, "failed to write mode registers: %d\n",
+			ret);
+		goto err_rpm_put;
+	}
+
+	/* Apply exposure, gain and frame length */
+	ret = __v4l2_ctrl_handler_setup(&s5k5e3->ctrls);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(s5k5e3->regmap, S5K5E3_REG_PAGE_POINTER,
+		  S5K5E3_PAGE_POINTER_DEFAULT, &ret);
+	cci_write(s5k5e3->regmap, S5K5E3_REG_MODE_SELECT,
+		  S5K5E3_MODE_STREAMING, &ret);
+	if (ret) {
+		dev_err(s5k5e3->dev, "failed to start streaming: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(s5k5e3->dev);
+	return ret;
+}
+
+static void s5k5e3_stop_streaming(struct s5k5e3 *s5k5e3)
+{
+	int ret;
+
+	ret = cci_write(s5k5e3->regmap, S5K5E3_REG_MODE_SELECT,
+			S5K5E3_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s5k5e3->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put(s5k5e3->dev);
+}
+
+static int s5k5e3_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+
+	if (enable)
+		ret = s5k5e3_start_streaming(s5k5e3);
+	else
+		s5k5e3_stop_streaming(s5k5e3);
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * Pad operations
+ */
+
+static void s5k5e3_fill_format(const struct s5k5e3_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = S5K5E3_MBUS_CODE;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k5e3_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = S5K5E3_MBUS_CODE;
+
+	return 0;
+}
+
+static int s5k5e3_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->code != S5K5E3_MBUS_CODE ||
+	    fse->index >= ARRAY_SIZE(s5k5e3_modes))
+		return -EINVAL;
+
+	fse->min_width = s5k5e3_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k5e3_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k5e3_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	const struct s5k5e3_mode *mode;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	mode = v4l2_find_nearest_size(s5k5e3_modes, ARRAY_SIZE(s5k5e3_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	s5k5e3_fill_format(mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		s5k5e3->mode = mode;
+		s5k5e3_update_blanking(s5k5e3);
+	}
+
+	return 0;
+}
+
+static int s5k5e3_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K5E3_NATIVE_WIDTH;
+		sel->r.height = S5K5E3_NATIVE_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = s5k5e3_modes[0].crop;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5k5e3_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = s5k5e3_modes[0].width,
+			.height = s5k5e3_modes[0].height,
+		},
+	};
+
+	return s5k5e3_set_fmt(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5k5e3_video_ops = {
+	.s_stream = s5k5e3_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops s5k5e3_pad_ops = {
+	.enum_mbus_code = s5k5e3_enum_mbus_code,
+	.enum_frame_size = s5k5e3_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k5e3_set_fmt,
+	.get_selection = s5k5e3_get_selection,
+};
+
+static const struct v4l2_subdev_core_ops s5k5e3_core_ops = {
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_ops s5k5e3_subdev_ops = {
+	.core = &s5k5e3_core_ops,
+	.video = &s5k5e3_video_ops,
+	.pad = &s5k5e3_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k5e3_internal_ops = {
+	.init_state = s5k5e3_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Power management
+ */
+
+/*
+ * Power up in the order of the Samsung MSM8916 (Galaxy J5) downstream
+ * sequence: supplies one after another (vana, vdig, vio) 1 ms apart, reset
+ * asserted for 2 ms and released 30 ms before EXTCLK is started.
+ */
+static int s5k5e3_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 1);
+
+	for (i = 0; i < S5K5E3_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(s5k5e3->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s supply: %d\n",
+				s5k5e3->supplies[i].supply, ret);
+			goto err_disable_supplies;
+		}
+		usleep_range(1000, 1100);
+	}
+
+	usleep_range(2000, 2100);
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 0);
+	msleep(30);
+
+	ret = clk_prepare_enable(s5k5e3->extclk);
+	if (ret) {
+		dev_err(dev, "failed to enable extclk: %d\n", ret);
+		goto err_reset;
+	}
+
+	/* Let the sensor boot before the first CCI access */
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 1);
+err_disable_supplies:
+	while (i--)
+		regulator_disable(s5k5e3->supplies[i].consumer);
+
+	return ret;
+}
+
+static int s5k5e3_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(s5k5e3->extclk);
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 1);
+
+	for (i = S5K5E3_NUM_SUPPLIES; i-- > 0;) {
+		regulator_disable(s5k5e3->supplies[i].consumer);
+		usleep_range(1000, 1100);
+	}
+
+	return 0;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k5e3_pm_ops, s5k5e3_power_off,
+				 s5k5e3_power_on, NULL);
+
+/* -----------------------------------------------------------------------------
+ * Probe & remove
+ */
+
+static int s5k5e3_identify(struct s5k5e3 *s5k5e3)
+{
+	u64 id, rev, gain_min, gain_max;
+	int ret = 0;
+
+	cci_read(s5k5e3->regmap, S5K5E3_REG_MODEL_ID, &id, &ret);
+	cci_read(s5k5e3->regmap, S5K5E3_REG_REVISION, &rev, &ret);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "failed to read model id\n");
+
+	dev_info(s5k5e3->dev, "model id 0x%04llx, revision 0x%02llx\n",
+		 id, rev);
+
+	/* The vendor driver never checks the id, so only warn */
+	if (id != S5K5E3_MODEL_ID)
+		dev_warn(s5k5e3->dev, "unexpected model id, expected 0x%04x\n",
+			 S5K5E3_MODEL_ID);
+
+	/* Analogue gain limits as used by the vendor driver */
+	s5k5e3->ana_gain_min = S5K5E3_ANA_GAIN_MIN;
+	s5k5e3->ana_gain_max = S5K5E3_ANA_GAIN_MAX;
+	cci_read(s5k5e3->regmap, S5K5E3_REG_ANA_GAIN_CODE_MIN, &gain_min, &ret);
+	cci_read(s5k5e3->regmap, S5K5E3_REG_ANA_GAIN_CODE_MAX, &gain_max, &ret);
+	if (!ret && gain_min >= S5K5E3_ANA_GAIN_MIN && gain_min < gain_max &&
+	    gain_max <= 0x0400) {
+		s5k5e3->ana_gain_min = gain_min;
+		s5k5e3->ana_gain_max = gain_max;
+	}
+	dev_dbg(s5k5e3->dev, "analogue gain codes %u..%u\n",
+		s5k5e3->ana_gain_min, s5k5e3->ana_gain_max);
+
+	return 0;
+}
+
+static int s5k5e3_parse_endpoint(struct s5k5e3 *s5k5e3)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	unsigned int i;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(s5k5e3->dev), NULL);
+	if (!fwnode)
+		return dev_err_probe(s5k5e3->dev, -ENXIO,
+				     "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != S5K5E3_NUM_LANES) {
+		ret = dev_err_probe(s5k5e3->dev, -EINVAL,
+				    "%u data lanes not supported, need %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes,
+				    S5K5E3_NUM_LANES);
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++)
+		if (ep.link_frequencies[i] == S5K5E3_LINK_FREQ)
+			break;
+
+	if (i == ep.nr_of_link_frequencies)
+		ret = dev_err_probe(s5k5e3->dev, -EINVAL,
+				    "link frequency %d Hz not in link-frequencies\n",
+				    S5K5E3_LINK_FREQ);
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int s5k5e3_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k5e3 *s5k5e3;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	s5k5e3 = devm_kzalloc(dev, sizeof(*s5k5e3), GFP_KERNEL);
+	if (!s5k5e3)
+		return -ENOMEM;
+
+	s5k5e3->dev = dev;
+	s5k5e3->mode = &s5k5e3_modes[0];
+
+	ret = s5k5e3_parse_endpoint(s5k5e3);
+	if (ret)
+		return ret;
+
+	s5k5e3->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k5e3->regmap))
+		return dev_err_probe(dev, PTR_ERR(s5k5e3->regmap),
+				     "failed to init CCI\n");
+
+	s5k5e3->extclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s5k5e3->extclk))
+		return dev_err_probe(dev, PTR_ERR(s5k5e3->extclk),
+				     "failed to get extclk\n");
+
+	/* The register tables assume 26 MHz, accept up to 1 % deviation */
+	rate = clk_get_rate(s5k5e3->extclk);
+	if (rate < S5K5E3_EXTCLK_RATE - S5K5E3_EXTCLK_RATE / 100 ||
+	    rate > S5K5E3_EXTCLK_RATE + S5K5E3_EXTCLK_RATE / 100)
+		return dev_err_probe(dev, -EINVAL,
+				     "extclk rate %lu Hz not supported\n", rate);
+
+	for (i = 0; i < S5K5E3_NUM_SUPPLIES; i++)
+		s5k5e3->supplies[i].supply = s5k5e3_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, S5K5E3_NUM_SUPPLIES,
+				      s5k5e3->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	/* Keep the sensor in reset until it is powered up */
+	s5k5e3->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k5e3->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5k5e3->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	v4l2_i2c_subdev_init(&s5k5e3->sd, client, &s5k5e3_subdev_ops);
+	s5k5e3->sd.internal_ops = &s5k5e3_internal_ops;
+
+	ret = s5k5e3_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = s5k5e3_identify(s5k5e3);
+	if (ret)
+		goto err_power_off;
+
+	ret = s5k5e3_init_controls(s5k5e3);
+	if (ret)
+		goto err_power_off;
+
+	s5k5e3->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE |
+			    V4L2_SUBDEV_FL_HAS_EVENTS;
+	s5k5e3->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k5e3->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k5e3->sd.entity, 1, &s5k5e3->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	s5k5e3->sd.state_lock = s5k5e3->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s5k5e3->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity_cleanup;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k5e3->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_pm_disable;
+	}
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm_disable:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&s5k5e3->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&s5k5e3->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&s5k5e3->ctrls);
+err_power_off:
+	s5k5e3_power_off(dev);
+
+	return ret;
+}
+
+static void s5k5e3_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s5k5e3->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		s5k5e3_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id s5k5e3_of_match[] = {
+	{ .compatible = "samsung,s5k5e3" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k5e3_of_match);
+
+static struct i2c_driver s5k5e3_driver = {
+	.driver = {
+		.name = "s5k5e3",
+		.of_match_table = s5k5e3_of_match,
+		.pm = pm_ptr(&s5k5e3_pm_ops),
+	},
+	.probe = s5k5e3_probe,
+	.remove = s5k5e3_remove,
+};
+module_i2c_driver(s5k5e3_driver);
+
+MODULE_DESCRIPTION("Samsung S5K5E3 image sensor driver");
+MODULE_LICENSE("GPL");
