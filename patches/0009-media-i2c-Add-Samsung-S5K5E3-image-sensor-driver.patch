+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S5K5E3 (ISOCELL 5E3) 5 Mpixel raw image sensor driver
+ *
+ * The register settings and timing parameters come from Samsung's GPL
+ * licensed Exynos 7870 kernel (fimc-is2 sensor module framework:
+ * fimc-is-cis-5e3.c, fimc-is-cis-5e3-setA.h and
+ * fimc-is-device-module-5e3.c).
+ *
+ * Clock tree, for the 26 MHz EXTCLK all register tables are written for:
+ *
+ *   EXTCLK / pre_pll_clk_div (0x0305 = 6) * pll_multiplier (0x0307 = 207)
+ *     = 26 MHz / 6 * 207 = 897 MHz PLL output
+ *   vt_pix_clk = 897 MHz / vt_sys_clk_div (0x3c1c[7:4] = 5)
+ *                        / vt_pix_clk_div (1) = 179.4 MHz
+ *
+ * The frame rate is vt_pix_clk / (line_length_pck * frame_length_lines),
+ * e.g. 179.4 MHz / (2950 * 1998) = 30.4 fps for the full resolution mode,
+ * so vt_pix_clk is reported as V4L2_CID_PIXEL_RATE.
+ *
+ * The CSI-2 output runs at the PLL output rate, 897 Mbps per lane (the
+ * table requests 0x0380 = 896 Mbps per lane in 0x0820), which carries the
+ * 179.4 Mpixel/s * 10 bits of RAW10 data over two lanes. The DDR link
+ * frequency is therefore 897 Mbps / 2 = 448.5 MHz.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define S5K5E3_REG_MODEL_ID		CCI_REG16(0x0000)
+#define S5K5E3_MODEL_ID			0x5e30
+#define S5K5E3_REG_REVISION		CCI_REG8(0x0002)
+#define S5K5E3_REG_ANA_GAIN_CODE_MIN	CCI_REG16(0x0084)
+#define S5K5E3_REG_ANA_GAIN_CODE_MAX	CCI_REG16(0x0086)
+
+#define S5K5E3_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define S5K5E3_MODE_STANDBY		0x00
+#define S5K5E3_MODE_STREAMING		0x01
+
+#define S5K5E3_REG_COARSE_INTEG_TIME	CCI_REG16(0x0202)
+#define S5K5E3_EXPOSURE_MIN		3
+#define S5K5E3_EXPOSURE_MARGIN		4
+#define S5K5E3_EXPOSURE_DEFAULT		0x0200
+
+/* Analogue gain code, gain = code / 32 */
+#define S5K5E3_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define S5K5E3_ANA_GAIN_MIN		0x0020
+#define S5K5E3_ANA_GAIN_MAX		0x0200
+#define S5K5E3_ANA_GAIN_DEFAULT		0x0020
+
+#define S5K5E3_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define S5K5E3_FRAME_LENGTH_MAX		0xffff
+#define S5K5E3_REG_LINE_LENGTH		CCI_REG16(0x0342)
+#define S5K5E3_LINE_LENGTH		2950
+
+/* Page pointer for indirect accesses, written before streaming */
+#define S5K5E3_REG_PAGE_POINTER		CCI_REG16(0x6028)
+#define S5K5E3_PAGE_POINTER_DEFAULT	0x4000
+
+#define S5K5E3_EXTCLK_RATE		(26 * HZ_PER_MHZ)
+#define S5K5E3_PIXEL_RATE		179400000
+#define S5K5E3_LINK_FREQ		448500000
+#define S5K5E3_NUM_LANES		2
+
+/* Pixel array as implied by the full resolution readout window */
+#define S5K5E3_NATIVE_WIDTH		2576
+#define S5K5E3_NATIVE_HEIGHT		1934
+
+static const char * const s5k5e3_supply_names[] = {
+	"vana",	/* Analogue 2.8 V */
+	"vdig",	/* Digital core */
+	"vio",	/* Digital I/O 1.8 V */
+};
+
+#define S5K5E3_NUM_SUPPLIES ARRAY_SIZE(s5k5e3_supply_names)
+
+static const s64 s5k5e3_link_freq_menu[] = {
+	S5K5E3_LINK_FREQ,
+};
