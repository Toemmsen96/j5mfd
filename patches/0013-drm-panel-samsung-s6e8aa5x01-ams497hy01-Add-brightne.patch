+/* MTP offset of point p (0 = V203, ..., 7 = V3, 8 = VT) for colour c */
+static int sd_mtp(const u8 *mtp, int p, int c)
+{
+	return sd_char_to_int(mtp[6 + 3 * p + c]);
+}
+
+/* v203_adjustment() ... v3_adjustment() */
+static int sd_adjust(int top, int upper, int mtp)
+{
+	u64 r1 = top - upper;
+	u64 r2 = (u64)(SD_COEFF + SD_CENTER + mtp) << SD_BIT_SHIFT;
+
+	do_div(r2, SD_DENOM);
+
+	return top - ((r1 * r2) >> SD_BIT_SHIFT);
+}
+
+/* v203_hexa() ... v3_hexa() */
+static u8 sd_hexa(int top, int gray, int upper_gray)
+{
+	u64 r1 = top - gray;
+	u64 r2 = r1 * SD_DENOM;
+	u32 r3 = top - upper_gray;
+
+	if (r3)
+		do_div(r2, r3);
+	else
+		r2 = 0;
+
+	return (r2 - SD_COEFF) & 0xff;
+}
+
+/* searching_function() with GAMMA_CURVE_2P0 */
+static int sd_search(s64 candela)
+{
+	unsigned int i;
+	s64 d1, d2;
+
+	for (i = 0; i < SD_GRAY_MAX - 1; i++) {
+		d1 = candela - sd_curve_2p0_360(i);
+		d2 = candela - sd_curve_2p0_360(i + 1);
+
+		if (d2 < 0)
+			return (d1 + d2) <= 0 ? i : i + 1;
+		if (d1 == 0)
+			return i;
+		if (d2 == 0)
+			return i + 1;
+	}
+
+	return -1;
+}
+
+/* v255_adjustment() ... v3_adjustment() and generate_gray_scale() */
+static void sd_init(struct sd_work *w, const u8 *mtp)
+{
+	int c, p, s, g, vt;
+	u64 r;
+
+	for (c = 0; c < 3; c++) {
+		int *gray = w->gray[c];
+
+		gray[0] = SD_VREG0;
+
+		/* V255 */
+		r = (u64)(SD_V255_COEFF + SD_CENTER_V255 + sd_mtp_v255(mtp, c))
+			<< SD_BIT_SHIFT;
+		do_div(r, SD_V255_DENOM);
+		gray[255] = SD_VREG0 - ((SD_VREG0 * r) >> SD_BIT_SHIFT);
+
+		/* VT */
+		vt = clamp(sd_mtp(mtp, 8, c), 0, (int)ARRAY_SIZE(sd_vt_coeff) - 1);
+		r = (u64)sd_vt_coeff[vt] << SD_BIT_SHIFT;
+		do_div(r, SD_VT_DENOM);
+		w->vt[c] = SD_VREG0 - ((SD_VREG0 * r) >> SD_BIT_SHIFT);
+
+		/* V203 ... V11 relative to VT, V3 relative to VREG0 */
+		for (p = 0; p < 7; p++)
+			gray[sd_points[8 - p]] = sd_adjust(w->vt[c],
+							   gray[sd_points[9 - p]],
+							   sd_mtp(mtp, p, c));
+		gray[3] = sd_adjust(SD_VREG0, gray[11], sd_mtp(mtp, 7, c));
+
+		/* cal_gray_scale_linear() between the inflection points */
+		for (s = 1; s < ARRAY_SIZE(sd_segments); s++) {
+			int from = sd_segments[s - 1], to = sd_segments[s];
+			int len = to - from;
+
+			for (g = from + 1; g < to; g++) {
+				r = (u64)(gray[from] - gray[to]) * (to - g)
+					<< SD_BIT_SHIFT;
+				do_div(r, len);
+				gray[g] = gray[to] + (r >> SD_BIT_SHIFT);
+			}
+		}
+	}
+}
+
+/* gamma_init() */
+static void sd_gamma(const struct sd_work *w, const u8 *mtp,
+		     enum s6e8aa5x01_rev rev, int cd_idx, u8 *out)
+{
+	int base = s6e8aa5x01_base_luminance[rev][cd_idx];
+	int idx[SD_NUM_POINTS];
+	int gamma[S6E8AA5X01_GAMMA_LEN];
+	int c, p, v;
+
+	for (p = 0; p < SD_NUM_POINTS; p++)
+		idx[p] = sd_search(sd_coeff_2p0(sd_points[p]) * base);
+
+	/* Candela compensation */
+	for (p = 1; p < SD_NUM_POINTS; p++) {
+		idx[SD_NUM_POINTS - p] +=
+			s6e8aa5x01_gradation_offset[rev][cd_idx][p - 1];
+		if (idx[SD_NUM_POINTS - p] == 0)
+			idx[SD_NUM_POINTS - p] = 1;
+	}
+
+	for (p = 0; p < SD_NUM_POINTS; p++)
+		idx[p] = clamp(idx[p], 0, SD_GRAY_MAX - 1);
+
+	for (c = 0; c < 3; c++) {
+		const int *gray = w->gray[c];
+
+		/* v255_hexa() */
+		u64 r = (u64)(SD_VREG0 - gray[idx[9]]) * SD_V255_DENOM;
+
+		do_div(r, SD_VREG0);
+		r -= SD_V255_COEFF;
+		out[2 * c] = (r & 0xff00) >> 8;
+		out[2 * c + 1] = r & 0xff;
+
+		/* v203_hexa() ... v11_hexa() */
+		for (p = 0; p < 7; p++)
+			out[6 + 3 * p + c] = sd_hexa(w->vt[c], gray[idx[8 - p]],
+						     gray[idx[9 - p]]);
+
+		/* v3_hexa() */
+		out[27 + c] = sd_hexa(SD_VREG0, gray[idx[1]], gray[idx[2]]);
+
+		/* vt_hexa() */
+		out[30 + c] = 0;
+	}
+
+	for (p = 0; p < S6E8AA5X01_GAMMA_LEN; p++)
+		gamma[p] = out[p];
+
+	/* RGB compensation */
+	for (c = 0; c < 3; c++) {
+		v = (out[2 * c] << 8 | out[2 * c + 1]) +
+		    s6e8aa5x01_rgb_offset[rev][cd_idx][c];
+		gamma[2 * c] = (v / 256) & 0xff;
+		gamma[2 * c + 1] = v & 0xff;
+	}
+	for (p = 3; p < 24; p++)
+		gamma[p + 3] += s6e8aa5x01_rgb_offset[rev][cd_idx][p];
+
+	/* mtp_offset_substraction() */
+	for (c = 0; c < 3; c++) {
+		v = (gamma[2 * c] << 8 | gamma[2 * c + 1]) - sd_mtp_v255(mtp, c);
+		gamma[2 * c] = (v / 256) & 0xff;
+		gamma[2 * c + 1] = v & 0xff;
+	}
+	for (p = 0; p < 8; p++)
+		for (c = 0; c < 3; c++)
+			gamma[6 + 3 * p + c] = clamp(gamma[6 + 3 * p + c] -
+						     sd_mtp(mtp, p, c), 0, 255);
+
+	for (p = 0; p < S6E8AA5X01_GAMMA_LEN; p++)
+		out[p] = gamma[p];
+}
+
+/* smart_dimming_init() */
+static int s6e8aa5x01_generate_gamma(const u8 *mtp, enum s6e8aa5x01_rev rev,
+				     u8 gamma[][S6E8AA5X01_GAMMA_LEN])
+{
+	struct sd_work *w;
+	int i;
+
+	w = kzalloc(sizeof(*w), GFP_KERNEL);
+	if (!w)
+		return -ENOMEM;
+
+	sd_init(w, mtp);
+
+	for (i = 0; i < S6E8AA5X01_NUM_CANDELA - 1; i++)
+		sd_gamma(w, mtp, rev, i, gamma[i]);
+
+	/* The highest step always uses the reference gamma. */
+	memcpy(gamma[i], s6e8aa5x01_default_gamma, S6E8AA5X01_GAMMA_LEN);
+
+	kfree(w);
+	return 0;
+}
+
+/*
+ * Read a panel register like the vendor kernel does: the read start offset
+ * is selected with the 0xb0 global parameter register and the data is read
+ * in chunks of at most 7 bytes (the vendor maximum return packet size).
+ * Level 1 key must be enabled.
+ */
+static int s6e8aa5x01_read(struct s6e8aa5x01_ams497hy01 *ctx, u8 reg,
+			   u8 offset, u8 *buf, size_t len)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	size_t pos, chunk;
+	ssize_t ret;
+
+	for (pos = 0; pos < len; pos += chunk) {
+		u8 b0[] = { 0xb0, offset + pos };
+
+		chunk = min_t(size_t, len - pos, S6E8AA5X01_READ_CHUNK);
+
+		ret = mipi_dsi_dcs_write_buffer(dsi, b0, sizeof(b0));
+		if (ret < 0)
+			return ret;
+
+		ret = mipi_dsi_dcs_read(dsi, reg, buf + pos, chunk);
+		if (ret != chunk) {
+			/* Do not leave the offset applied to the next command */
+			b0[1] = 0;
+			mipi_dsi_dcs_write_buffer(dsi, b0, sizeof(b0));
+			return ret < 0 ? ret : -EIO;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Read panel ID, ELVSS OTP value and the MTP gamma offsets (once) and
+ * generate the smart dimming gamma table. Failures are not fatal: without
+ * the MTP data the reference gamma is kept and only AID/ELVSS change with
+ * the brightness. Level 1 key must be enabled.
+ */
+static void s6e8aa5x01_read_otp(struct s6e8aa5x01_ams497hy01 *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	u8 mtp[S6E8AA5X01_MTP_LEN];
+	u8 id[3];
+	int ret;
+
+	if (!ctx->id_valid) {
+		ret = s6e8aa5x01_read(ctx, 0xda, 0, &id[0], 1);
+		if (!ret)
+			ret = s6e8aa5x01_read(ctx, 0xdb, 0, &id[1], 1);
+		if (!ret)
+			ret = s6e8aa5x01_read(ctx, 0xdc, 0, &id[2], 1);
+		if (ret < 0) {
+			dev_warn(dev, "Failed to read panel ID: %d\n", ret);
+			return;
+		}
+
+		ctx->rev = id[2] == 0x02 ? S6E8AA5X01_REV_A : S6E8AA5X01_REV_C;
+		ctx->id_valid = true;
+		dev_info(dev, "Panel ID %02x %02x %02x (rev %c)\n",
+			 id[0], id[1], id[2],
+			 ctx->rev == S6E8AA5X01_REV_A ? 'A' : 'C');
+	}
+
+	if (!ctx->elvss_otp_valid) {
+		ret = s6e8aa5x01_read(ctx, 0xb6, S6E8AA5X01_ELVSS_OTP_OFFSET,
+				      &ctx->elvss_otp, 1);
+		if (ret < 0)
+			dev_warn(dev, "Failed to read ELVSS OTP: %d\n", ret);
+		else
+			ctx->elvss_otp_valid = true;
+	}
+
+	if (!ctx->gamma_valid) {
+		ret = s6e8aa5x01_read(ctx, 0xc8, 0, mtp, sizeof(mtp));
+		if (ret < 0) {
+			dev_warn(dev, "Failed to read MTP, smart dimming disabled: %d\n",
+				 ret);
+			return;
+		}
+		ret = s6e8aa5x01_generate_gamma(mtp, ctx->rev, ctx->gamma);
+		if (ret < 0)
+			return;
+		ctx->gamma_valid = true;
+		dev_info(dev, "Smart dimming enabled, MTP: %*ph\n",
+			 (int)sizeof(mtp), mtp);
+	}
+}
+
+static int s6e8aa5x01_level_to_candela_idx(int level)
+{
+	int i;
+
+	for (i = 0; i < S6E8AA5X01_NUM_CANDELA - 1; i++)
+		if (level <= s6e8aa5x01_candela_map[i].max_level)
+			break;
+
+	return i;
+}
+
+/*
+ * Brightness update as built by mdss_samsung_normal_brightenss_packet_set()
+ * in the vendor kernel: AID, ACL, ELVSS, temperature dependent ELVSS, gamma
+ * and gamma update, all with level 1 key enabled.
+ */
+static int s6e8aa5x01_set_brightness(struct s6e8aa5x01_ams497hy01 *ctx,
+				     int level)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int idx = s6e8aa5x01_level_to_candela_idx(level);
+	int candela = s6e8aa5x01_candela_map[idx].candela;
+	u16 aid = s6e8aa5x01_aid[ctx->rev][idx];
+	u8 b2[] = { 0xb2, aid >> 8, aid & 0xff };
+	u8 b6[] = { 0xb6, 0xbc, s6e8aa5x01_elvss[idx] };
+	u8 b8[] = { 0xb8, S6E8AA5X01_TEMPERATURE };
+	u8 ca[S6E8AA5X01_GAMMA_LEN + 1] = { 0xca };
+
+	memcpy(&ca[1], ctx->gamma_valid ? ctx->gamma[idx] :
+	       s6e8aa5x01_default_gamma, S6E8AA5X01_GAMMA_LEN);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+
+	/* AID */
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, b2, sizeof(b2));
+
+	/* ACL 15% below the maximum level, off at the maximum level */
+	if (level < S6E8AA5X01_MAX_BRIGHTNESS) {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x02);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x50);
+	} else {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x40);
+	}
+
+	/* ELVSS */
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, b6, sizeof(b6));
+
+	/* Temperature (8th parameter of 0xb8) */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x07);
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, b8, sizeof(b8));
+
+	/* Low luminance ELVSS (22nd parameter of 0xb6) */
+	if (ctx->elvss_otp_valid) {
+		b6[1] = candela > 29 ? ctx->elvss_otp :
+			candela > 20 ? 0x07 : 0x05;
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0,
+					     S6E8AA5X01_ELVSS_OTP_OFFSET);
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, b6, 2);
+	}
+
+	/* Gamma */
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, ca, sizeof(ca));
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8aa5x01_ams497hy01_brightness(struct s6e8aa5x01_ams497hy01 *ctx)
+{
+	if (ctx->bl)
+		return ctx->bl->props.brightness;
+
+	return S6E8AA5X01_DEFAULT_BRIGHTNESS;
+}
