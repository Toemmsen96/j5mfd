+/*
+ * Smart dimming: the panel stores per-panel gamma offsets ("MTP", register
+ * 0xc8, same layout as the 0xca gamma register). Together with the reference
+ * gamma above they describe the panel's calibrated 360 cd gamma curve. The
+ * gamma register values for every other candela step are generated from it
+ * with the vendor algorithm below, which is a straight port of
+ * ss_dsi_smart_dimming_S6E8AA5X01_AMS497HY01.c (including its integer
+ * arithmetic and rounding) so that the generated tables are identical to the
+ * ones used by the vendor kernel.
+ *
+ * Voltages are fixed point values with 22 fractional bits.
+ */
+#define SD_BIT_SHIFT		22
+#define SD_VREG0		24326963	/* 5.8 V */
+#define SD_GRAY_MAX		256
+#define SD_NUM_POINTS		10
+#define SD_V255_COEFF		72
+#define SD_V255_DENOM		860
+#define SD_VT_DENOM		860
+#define SD_COEFF		64
+#define SD_DENOM		320
+#define SD_CENTER_V255		0x100
+#define SD_CENTER		0x80
+
+/* Gray levels of the gamma inflection points: V1, V3, V11, ..., V255 */
+static const u8 sd_points[SD_NUM_POINTS] = {
+	1, 3, 11, 23, 35, 51, 87, 151, 203, 255,
+};
+
+/* Inflection points used for the linear gray scale interpolation */
+static const u8 sd_segments[] = {
+	0, 3, 11, 23, 35, 51, 87, 151, 203, 255,
+};
+
+static const u8 sd_vt_coeff[] = {
+	0, 12, 24, 36, 48, 60, 72, 84, 96, 108, 138, 148, 158, 168, 178, 186,
+};
+
+struct sd_work {
+	int vt[3];
+	int gray[3][SD_GRAY_MAX];
+};
+
+/*
+ * candela_coeff_2p0[] and curve_2p0_360[] of the vendor kernel:
+ * round((index / 255)^2.0 * 2^22) and round(360 * (index / 255)^2.0 * 2^22).
+ */
+static s64 sd_coeff_2p0(unsigned int index)
+{
+	return DIV_ROUND_CLOSEST_ULL((u64)index * index << SD_BIT_SHIFT, 255 * 255);
+}
+
+static s64 sd_curve_2p0_360(unsigned int index)
+{
+	return DIV_ROUND_CLOSEST_ULL(360ULL * index * index << SD_BIT_SHIFT, 255 * 255);
+}
+
+static int sd_char_to_int(u8 data)
+{
+	return (data & 0x80) ? -(data & 0x7f) : data;
+}
+
+/* MTP offset of V255 for colour c (0 = R, 1 = G, 2 = B) */
+static int sd_mtp_v255(const u8 *mtp, int c)
+{
+	return mtp[2 * c] ? -mtp[2 * c + 1] : mtp[2 * c + 1];
+}
